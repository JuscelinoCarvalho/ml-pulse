# ─── Banco de dados ───────────────────────────────────────────
POSTGRES_USER=mlpulse
POSTGRES_PASSWORD=TROQUE_AQUI
POSTGRES_DB=mlpulse

# ─── Segurança ────────────────────────────────────────────────
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI   # python -c "import secrets; print(secrets.token_hex(32))"
FERNET_KEY=GERE_AQUI                   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ─── E-mail (SMTP) ────────────────────────────────────────────
# Para desenvolvimento, use Mailpit (já no docker-compose).
# Para produção, configure seu SMTP real abaixo.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mlpulse.local
SMTP_TLS=false

# ─── Mercado Livre ────────────────────────────────────────────
# Cadastre seu app em: https://developers.mercadolivre.com.br
ML_CLIENT_ID=SEU_CLIENT_ID
ML_CLIENT_SECRET=SEU_CLIENT_SECRET
ML_REDIRECT_URI=http://localhost:8000/api/auth/ml/callback
ML_SITE_ID=MLB   # MLB = Brasil

# ─── App ──────────────────────────────────────────────────────
APP_NAME=ML Pulse
FRONTEND_URL=http://localhost:3000
OTP_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
